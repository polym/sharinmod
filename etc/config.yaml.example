# Claw Types Configuration
# 每个 claw_type 定义：
#   image          - 容器镜像地址
#   model_id       - 传入 config_template 的 {{MODEL_ID}} 占位符
#   command        - （可选）覆盖容器 entrypoint，对应 K8s spec.containers[].command
#                    省略时使用镜像默认 entrypoint
#   config_template - dict，key 为挂载到 /config/ 目录下的文件名，value 为文件内容模版
#                     每个 value 支持以下占位符：
#                     {{MODEL_ID}}        - AI 模型 ID
#                     {{OPENAI_KEY}}      - LiteLLM 生成的 API Key
#                     {{OPENAI_BASE_URL}} - OpenAI-compatible API 基地址
#                     {{YOUR_APP_ID}}     - QQ Bot App ID
#                     {{YOUR_APP_SECRET}} - QQ Bot App Secret

# 工作区持久化存储配置
workspace_storage_class: ""     # 空字符串使用集群默认 StorageClass
workspace_storage_size: "10Gi"  # 每只龙虾的 /app/workspace 数据盘大小

# Application Configuration
# 敏感配置（如密钥、密码等）支持环境变量 fallback
# 环境变量优先级：YAML 值 > 环境变量（当 YAML 中值为 null 或空字符串时）
app:
  # Environment
  env: "development"  # development | staging | production

  # Database (敏感配置，支持环境变量 fallback: DATABASE_URI)
  # 使用环境变量: DATABASE_URI
  database_uri: ""

  # JWT Secret Key (敏感配置，支持环境变量 fallback: SECRET_KEY)
  # 使用环境变量: SECRET_KEY
  # 如果未设置，将自动生成随机密钥（每次重启会变化）
  secret_key: ""

  # GitHub OAuth (敏感配置，支持环境变量 fallback: GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET)
  # 使用环境变量: GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET
  github_client_id: ""
  github_client_secret: ""
  github_redirect_uri: "http://localhost:18888/api/oauth/github/callback"

  # GitLab OAuth (敏感配置，支持环境变量 fallback: GITLAB_CLIENT_ID, GITLAB_CLIENT_SECRET)
  # 使用环境变量: GITLAB_CLIENT_ID, GITLAB_CLIENT_SECRET
  gitlab_client_id: ""
  gitlab_client_secret: ""
  gitlab_base_url: "https://gitlab.com"
  gitlab_redirect_uri: "http://localhost:18888/api/oauth/gitlab/callback"

  # Website
  website_base_url: "http://localhost:18888"

  # LiteLLM (敏感配置，支持环境变量 fallback: LITELLM_BASE_URL, LITELLM_MASTER_KEY)
  # 使用环境变量: LITELLM_BASE_URL, LITELLM_MASTER_KEY
  litellm_base_url: ""
  litellm_master_key: ""

  # Assets
  assets_path: "/app/assets"

  # Redis
  redis_database: "redis://redis:6379/"

  # Admin User (敏感配置，支持环境变量 fallback: SHARINMOD_ADMIN_EMAIL, SHARINMOD_ADMIN_PASSWORD)
  # 使用环境变量: SHARINMOD_ADMIN_EMAIL, SHARINMOD_ADMIN_PASSWORD
  sharinmod_admin_email: ""
  sharinmod_admin_password: ""

  # JWT
  access_token_expire_minutes: 10080  # 7 days

  # Vendor API Base URLs
  vendor_base_urls:
    bigmodel: "https://open.bigmodel.cn/api/anthropic"
    "z.ai": "https://z.ai/api/anthropic"
    volcengine: "https://ark.cn-beijing.volces.com/api/coding"
    moonshot: "https://api.kimi.com/coding"
    minimax: "https://api.minimaxi.com/anthropic"
    openrouter: "https://openrouter.ai/api/v1"

claw_types:
  NANOBOT:
    image: "hub.upyun.com/huixingyun/nanobot:latest"
    model_id: "minimax-m2.5"
    command: ["bash", "-c", "cp /config/config.json /app/config.json && nanobot gateway -c /app/config.json"]
    config_template:
      config.json: |
        {
          "agents": {
            "defaults": {
              "workspace": "/app/workspace",
              "model": "{{MODEL_ID}}",
              "provider": "custom",
              "maxTokens": 8192,
              "temperature": 0.1,
              "maxToolIterations": 40,
              "memoryWindow": 100,
              "reasoningEffort": null,
              "memory": {
                "path": "/app/memory"
              }
            }
          },
          "providers": {
            "custom": {
              "apiKey": "{{OPENAI_KEY}}",
              "apiBase": "{{OPENAI_BASE_URL}}",
              "extraHeaders": null
            }
          },
          "channels": {
            "qq": {
              "enabled": true,
              "appId": "{{YOUR_APP_ID}}",
              "secret": "{{YOUR_APP_SECRET}}",
              "allowFrom": ["*"],
              "msgFormat": "plain"
            }
          }
        }

  OPENCLAW:
    image: "openclaw:local"
    model_id: "minimax-m2.5"
    command: ["bash", "-c", "cp /config/config.json /root/.openclaw/openclaw.json && openclaw gateway --allow-unconfigured"]
    config_template:
      config.json: |
        {
          "models": {
            "mode": "merge",
            "providers": {
              "custom": {
                "baseUrl": "{{OPENAI_BASE_URL}}",
                "apiKey": "{{OPENAI_KEY}}",
                "api": "anthropic-messages",
                "models": [
                  {
                    "id": "{{MODEL_ID}}",
                    "name": "{{MODEL_ID}} (Custom Provider)",
                    "reasoning": false,
                    "input": [
                      "text"
                    ],
                    "cost": {
                      "input": 0,
                      "output": 0,
                      "cacheRead": 0,
                      "cacheWrite": 0
                    },
                    "contextWindow": 131072,
                    "maxTokens": 4096
                  }
                ]
              }
            }
          },
          "agents": {
            "defaults": {
              "model": {
                "primary": "custom/{{MODEL_ID}}"
              },
              "models": {
                "custom/{{MODEL_ID}}": {}
              },
              "workspace": "/app/workspace",
              "compaction": {
                "mode": "safeguard"
              }
            },
            "list": [
              {
                "id": "main"
              }
            ]
          },
          "commands": {
            "native": "auto",
            "nativeSkills": "auto",
            "restart": true,
            "ownerDisplay": "raw"
          },
          "session": {
            "dmScope": "per-channel-peer"
          },
          "channels": {
            "qqbot": {
              "enabled": true,
              "allowFrom": [
                "*"
              ],
              "appId": "{{YOUR_APP_ID}}",
              "clientSecret": "{{YOUR_APP_SECRET}}"
            }
          },
          "plugins": {
            "entries": {
              "openclaw-qqbot": {
                "enabled": true
              }
            }
          }
        }

  ZEROBOT:
    image: "registry.example.com/zerobot:latest"
    model_id: "gpt-4o-mini"
    config_template:
      config.toml: |
        [model]
        model_id = "{{MODEL_ID}}"
        api_key = "{{OPENAI_KEY}}"
        base_url = "{{OPENAI_BASE_URL}}"

        [bot]
        app_id = "{{YOUR_APP_ID}}"
        app_secret = "{{YOUR_APP_SECRET}}"

        [server]
        host = "0.0.0.0"
        port = 8080
